#include <bits/stdc++.h>
using namespace std;

class SymmetricMatrix {
    int n;
    vector<int> arr;

public:
    SymmetricMatrix(int n) {
        this->n = n;
        arr.resize(n * (n + 1) / 2);
    }

    void set(int i, int j, int val) {
        if (i >= j) { //lower triangular
            arr[i * (i + 1) / 2 + j] = val;
        } else { 
            arr[j * (j + 1) / 2 + i] = val;
        }
    }

    int get(int i, int j) {
        if (i >= j)
            return arr[i * (i + 1) / 2 + j];
        else
            return arr[j * (j + 1) / 2 + i];
    }
};
