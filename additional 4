#include<iostream>
#include<stack>
#include<algorithm>
using namespace std;
void dailyTemperatures(int arr[],int n)
{
	int dt[n];
	fill(dt,dt+n,0);
	stack<int>st;
	int i;
	
	for(int i=n-1; i>=0; i--) {
        while(!st.empty() && st.top() <arr[i]) {
            st.pop();
        }
        if(!st.empty()) {
        	auto it=find(arr,arr+n,st.top());
            dt[i] = (it-arr)-i;                //it - arr  gives the index of the found element else it is just a pointer
        }
        st.push(arr[i]);
    }
    for(int i=0; i<n; i++) {
        cout << dt[i] << " ";
    }
    cout << endl;
}
int main()
{
	int arr[]={73,74,75,71,69,72,76,73};
	int n =sizeof(arr)/sizeof(arr[0]);
	dailyTemperatures(arr,n);
	return 0;
}
