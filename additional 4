
using namespace std;

void sortArray(vector<int> &arr, int n)
{
    int low = 0, mid = 0, high = n - 1;
    while (mid <= high)
    {
        if (arr[mid] == 0)
        {
            swap(arr[low], arr[mid]);
            low++;
            mid++;
        }
        else if (arr[mid] == 1)
        {
            mid++;
        }
        else 
        {
            swap(arr[mid], arr[high]);
            high--;
        }
    }
}

int main()
{
    int a[] = {0, 1, 2, 0, 1, 1, 2, 2, 2, 0, 1};
    vector<int> arr(a, a + sizeof(a) / sizeof(a[0]));

    int n = arr.size();
    sortArray(arr, n);   // sorts in-place

    cout << "Your sorted array:" << endl;
    for (auto it : arr)
    {
        cout << it << " ";
    }
    cout << endl;

    return 0;
}
