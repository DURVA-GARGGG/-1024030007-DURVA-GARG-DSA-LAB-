#include<iostream>
#include<cstring>
using namespace std;
int main()
{
	char c[]="jenny";
	int n=sizeof(c)/sizeof(c[0]);
	int i,j;
	char temp;
	
	for(i=0;i<n-1;i++)
	{
		for(j=i+1;j<n-1;j++)
		{
			if(c[i]>c[j])
			{
				temp=c[i];
				c[i]=c[j];
				c[j]=temp;
			}
		}
	}
	cout<<"your sorted string is: "<<c;
	return 0;
}
