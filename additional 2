void removeEvenFromDLL(Node* &head) {
    if (!head) return;
    Node* curr = head;

    while (curr) {

        Node* nxt = curr->next;
        if (curr->data % 2 == 0) {
            if (curr == head) {
                head = curr->next;
                if (head) head->prev = NULL;
            } 
            else {
                curr->prev->next = curr->next;
                if (curr->next)
                    curr->next->prev = curr->prev;
            }

            delete curr;
        }

        curr = nxt;
    }
}
