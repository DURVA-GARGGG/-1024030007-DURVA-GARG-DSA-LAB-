#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter dimension of matrix: ";
    cin >> n;

    int size = n * (n + 1) / 2;  // total non-zero elements
    int arr[size];

    cout << "Enter lower triangular elements row-wise:\n";
    int k = 0;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j <= i; j++) {
            cout << "Element at (" << i << "," << j << "): ";
            cin >> arr[k++];
        }
    }

    cout << "\nYour lower triangular matrix is:\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i >= j)
                cout << arr[i*(i+1)/2 + j] << " ";
            else
                cout << 0 << " ";
        }
        cout << endl;
    }

    return 0;
}
