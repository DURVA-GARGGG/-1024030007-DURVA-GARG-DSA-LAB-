#include<iostream>
using namespace std;
int main()
{
	int arr[] = {1,0,2,3,0,4,5,0};
	int n=sizeof(arr)/sizeof(arr[0]);
	
	int i,j;
	for(i=0;i<n;i++)
	{
		if(arr[i]==2)
		{
			for(j=n-1;j>=i;j--)
			{
				arr[j+1]=arr[j];
			}
			arr[i+1]=2;
			i++;
		}
	}
	cout<<"array after the modifications: "<<endl;
	for(i=0;i<n;i++)
	{
		cout<<arr[i]<<" ";
	}
	return 0;
}
