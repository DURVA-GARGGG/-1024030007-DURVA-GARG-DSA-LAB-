struct Node {
    int data;
    Node *next, *prev, *up, *down;

    Node(int x) {
        data = x;
        next = prev = up = down = NULL;
    }
};
Node* convertMatrixToDLL(vector<vector<int>>& mat) {
    int r = mat.size();
    int c = mat[0].size();

    vector<vector<Node*>> grid(r, vector<Node*>(c, NULL));

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            grid[i][j] = new Node(mat[i][j]);
        }
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c - 1; j++) {
            grid[i][j]->next = grid[i][j + 1];
            grid[i][j + 1]->prev = grid[i][j];
        }
    }

    for (int j = 0; j < c; j++) {
        for (int i = 0; i < r - 1; i++) {
            grid[i][j]->down = grid[i + 1][j];
            grid[i + 1][j]->up = grid[i][j];
        }
    }

    return grid[0][0];
}
