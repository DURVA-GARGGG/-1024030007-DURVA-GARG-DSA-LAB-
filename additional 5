// Search for root index in inorder
int searchInorder(int inorder[], int start, int end, int value) {
    for (int i = start; i <= end; i++) {
        if (inorder[i] == value)
            return i;
    }
    return -1;
}

// Global index for preorder traversal
int preIndex = 0;


Node* buildTree(int inorder[], int preorder[], int inStart, int inEnd) {
    if (inStart > inEnd) return NULL;

    int rootVal = preorder[preIndex++];
    Node* root = newNode(rootVal);

    // If leaf node
    if (inStart == inEnd) return root;

    int mid = searchInorder(inorder, inStart, inEnd, rootVal);

    root->left = buildTree(inorder, preorder, inStart, mid - 1);
    root->right = buildTree(inorder, preorder, mid + 1, inEnd);

    return root;
}
