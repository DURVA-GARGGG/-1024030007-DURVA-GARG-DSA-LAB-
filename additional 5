#include <bits/stdc++.h>
using namespace std;

int main() {
    int N;
    cin >> N;

    vector<int> A(N);
    for (int i = 0; i < N; i++) cin >> A[i];

    vector<int> target = A;
    sort(target.begin(), target.end());

    stack<int> S;
    int idx = 0; 

    for (int x : A) {
        S.push(x);

        while (!S.empty() && S.top() == target[idx]) {
            S.pop();
            idx++;
        }
    }

    while (!S.empty() && S.top() == target[idx]) {
        S.pop();
        idx++;
    }

    if (idx == N) cout << "YES\n";
    else cout << "NO\n";

    return 0;
}
