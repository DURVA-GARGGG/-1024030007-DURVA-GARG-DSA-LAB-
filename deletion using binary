#include<iostream>
using namespace std;
int main()
{
  int val;
   cout<<"enter the value you want to delete: ";
   cin>>val;
  
  int arr[]={1,2,3,5,6,7,10};
   int n=sizeof(arr)/sizeof(arr[0]);
   int l=0,r=n-1,mid,i;
   bool flag=false;
  int pos = -1; // store position of element if found
   
   while(l<=r)
   {
    mid=l+((r-l)/2);
    if(val==arr[mid])
    {
    flag=true;
      pos = mid;
      break;
    }
  else if(val>arr[mid])
    l=mid+1;
   
    else
    r=mid-1;
   }
   if(flag==true)
   {
  
  for(i=pos;i<n;i++)
    arr[i]=arr[i+1];
     n-=1;
   }
   else
   {
    cout<<"value can't be deleted"<<endl;
   }
   cout<<"your array:"<<endl;
   for(i=0;i<n;i++)
   cout<<arr[i]<<" ";
}
