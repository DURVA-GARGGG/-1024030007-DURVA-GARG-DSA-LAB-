#include<iostream>
using namespace std;
int main()
{
	int arr[]={64,34,25,12,22,11,90};
	int n=sizeof(arr)/sizeof(arr[0]);
	int i,j,temp;
	
	for(i=0;i<n-1;i++)
	{
		for(j=i+1;j<n;j++)
		{
			if(arr[i]>arr[j])
			{
				temp=arr[j];
				arr[j]=arr[i];
				arr[i]=temp;
			}
		}
	}
	cout<<"your sorted array in ascending order is:"<<endl;
	for(i=0;i<n;i++)
	{
		cout<<arr[i]<<" ";
	}
	return 0;
}
