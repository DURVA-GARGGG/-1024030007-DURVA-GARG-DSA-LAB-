#include <iostream>
#include <queue>
using namespace std;

class Stack {
    queue<int> q;

public:
    void push(int x);
    void pop();
    int top();
    bool empty();
};
void Stack::push(int x) {
    int n = q.size();   
    q.push(x);          

    // rotate the queue to bring x to the front
    for (int i = 0; i < n; i++) {
        q.push(q.front());
        q.pop();
    }
}
void Stack::pop() {
    if (q.empty()) {
        cout << "Stack underflow\n";
        return;
    }
    q.pop();
}
int Stack::top() {
    if (q.empty()) {
        cout << "Stack is empty\n";
        return -1;
    }
    return q.front();
}
bool Stack::empty() {
    return q.empty();
}

int main() {
    Stack s;
    s.push(1);
    s.push(2);
    s.push(3);

    cout << "Top element: " << s.top() << endl; // 3
    s.pop();
    cout << "Top element after pop: " << s.top() << endl; // 2
    s.pop();
    cout << "Top element after pop: " << s.top() << endl; // 1
    s.pop();
    s.pop(); // underflow

    return 0;
}
