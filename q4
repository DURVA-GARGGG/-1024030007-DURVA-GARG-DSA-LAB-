#include<iostream>
#include<string>
#include<stack>
using namespace std;

int priority(char c) {
    if(c=='^')
        return 3;
    else if(c=='/' || c=='*')
        return 2;
    else if(c=='+' || c=='-')
        return 1;
    else
        return -1;
}

string infixToPostfix(string b) {
    int n = b.length();
    stack<char> st;
    string ans;

    for(int i=0;i<n;i++) {
        if((b[i]>='A' && b[i]<='Z') || (b[i]>='a' && b[i]<='z') || (b[i]>='0' && b[i]<='9')) {
            ans += b[i];
        }

        else if(b[i]=='(') {
            st.push(b[i]);
        }
      
        else if(b[i]==')') {
            while(!st.empty() && st.top()!='(') {
                ans += st.top();
                st.pop();
            }
           st.pop(); // remove '('
        }
        
        else {
            while(!st.empty() && priority(b[i]) <= priority(st.top())) {
                ans += st.top();
                st.pop();
            }
            st.push(b[i]);
        }
    }

    // pop all remaining operators
    while(!st.empty()) {
        ans += st.top();
        st.pop();
    }

    return ans;
}

int main() {
    string expr;
    cout << "Enter an infix expression: ";
    cin >> expr;
    cout << "Postfix expression: " << infixToPostfix(expr) << endl;
    return 0;
}
