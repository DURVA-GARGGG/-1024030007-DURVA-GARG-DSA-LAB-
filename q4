#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    cin >> s;

    queue<char> q;
    vector<int> freq(26, 0);

    for (char ch : s) {
        freq[ch - 'a']++;
        q.push(ch);

        // remove all repeating characters from front
        while (!q.empty() && freq[q.front() - 'a'] > 1) {
            q.pop();
        }

        if (q.empty()) 
            cout << -1 << " ";
        else 
            cout << q.front() << " ";
    }

    return 0;
}
