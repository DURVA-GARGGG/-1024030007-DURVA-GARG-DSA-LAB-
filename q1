//insertion using binary search
#include <iostream>
using namespace std;
int  main()
{
   int val;
   cout<<"enter the value you want to insert: ";
   cin>>val;
   
   int arr[]={1,2,3,5,6,7,10};
   int n=sizeof(arr)/sizeof(arr[0]);
   int l=0,r=n-1,mid,i;
   bool flag=false;
   
   while(l<=r)
   {
    mid=l+((r-l)/2);
    if(val==arr[mid])
    {
    flag=true;
break;

   }
 
   
    else if(val>arr[mid])
    l=mid+1;
   
    else
    r=mid-1;
   }
   if(flag==true)
   cout<<"value can't be inserted"<<endl;
   else
   {
    for(i=n-1;i>l;i--)
    {
    arr[i+1]=arr[i];
  }
     arr[l]=val;
       n++;
   }
   cout<<"your array:"<<endl;
   for(i=0;i<n;i++)
   cout<<arr[i]<<" ";
}
