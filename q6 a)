#include <iostream>
#include<algorithm>
using namespace std;

struct Term {
    int row, col, val;
};

int main() {
    int m, n, num; // matrix dimensions and number of non-zero elements
    cout << "Enter rows and columns of matrix: ";
    cin >> m >> n;
    cout << "Enter number of non-zero elements: ";
    cin >> num;

    Term a[num+1];  // triplet representation
    cout << "Enter row, column and value for each non-zero element:\n";
    for (int i = 0; i < num; i++) {
        cin >> a[i].row >> a[i].col >> a[i].val;
    }

    // Transpose: swap row and col
    for (int i = 0; i < num; i++) {
        int temp = a[i].row;
        a[i].row = a[i].col;
        a[i].col = temp;
    }

    // Sorting in row-major order 
    for (int i = 0; i < num - 1; i++) {
        for (int j = i + 1; j < num; j++) {
            if (a[i].row > a[j].row || (a[i].row == a[j].row && a[i].col > a[j].col)) {
                swap(a[i], a[j]);
            }
        }
    }

    // Print transposed sparse matrix
    cout << "\nTranspose in triplet form:\n";
    cout << "Row Col Value\n";
    for (int i = 0; i < num; i++) {
        cout << a[i].row << "   " << a[i].col << "   " << a[i].val << endl;
    }

    return 0;
}
