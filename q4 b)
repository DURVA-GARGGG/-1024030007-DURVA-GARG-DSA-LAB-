#include<iostream>
#include<cstring>
using namespace std;
int main()
{
	char c[]="jenny";
	int n=sizeof(c)/sizeof(c[0]);
	int i,j,temp;
	
	for(i=0,j=n-2;i<(n-1)/2;i++,j--)
	{
		temp=c[i];
		c[i]=c[j];
		c[j]=temp;
	}
	cout<<"Your reversed string is:"<<endl;
	for(i=0;i<n-1;i++)
	{
		cout<<c[i];
	}
	return 0;
}
