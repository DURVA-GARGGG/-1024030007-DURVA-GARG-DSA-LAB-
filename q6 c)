#include <bits/stdc++.h>
using namespace std;

struct Triplet {
    int r, c, v;
};

int main() {
    int m1, n1, t1;
    int m2, n2, t2;

    cin >> m1 >> n1 >> t1;
    vector<Triplet> A(t1);
    for (auto &x : A) cin >> x.r >> x.c >> x.v;

    cin >> m2 >> n2 >> t2;
    vector<Triplet> B(t2);
    for (auto &x : B) cin >> x.r >> x.c >> x.v;

    if (n1 != m2) {
        cout << "Multiplication not possible\n";
        return 0;
    }

    map<pair<int,int>, int> C;

    for (auto &a : A) {
        for (auto &b : B) {
            if (a.c == b.r) { 
                C[{a.r, b.c}] += a.v * b.v;
            }
        }
    }

    vector<Triplet> result;
    for (auto &p : C) {
        if (p.second != 0) {
            result.push_back({p.first.first, p.first.second, p.second});
        }
    }

    cout << m1 << " " << n2 << " " << result.size() << "\n";
    for (auto &x : result) {
        cout << x.r << " " << x.c << " " << x.v << "\n";
    }

    return 0;
}
