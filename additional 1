#include<iostream>
#include<stack>
#include<algorithm>
using namespace std;
void nearestSmaller(int arr[],int n)
{
	int ns[n];
	fill(ns,ns+n,-1);
	stack<int>st;
	int i;
	
	for(int i=0; i<n; i++) {
        while(!st.empty() && st.top() >= arr[i]) {
            st.pop();
        }
        if(!st.empty()) {
            ns[i] = st.top();
        }
        st.push(arr[i]);
    }

    for(int i=0; i<n; i++) {
        cout << ns[i] << " ";
    }
    cout << endl;
}
int main()
{
	int arr[]={4, 5, 2, 10, 8};
	int n =sizeof(arr)/sizeof(arr[0]);
	nearestSmaller(arr,n);
	return 0;
}
