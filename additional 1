#include<iostream>
using namespace std;
int main()
{
	int arr[]={1,5,3,4,2};  
	int k=2;
	int n=sizeof(arr)/sizeof(arr[0]);
	int i,j,cnt=0;
	
	for(i=0;i<n;i++)
	{
		for(j=i+1;j<n;j++)
		{
			if((arr[i]-arr[j]==k)||(arr[i]-arr[j]==-k))
			cnt++;
		}
	}
	cout<<"all pairs (i, j) such that i < j and absolute value of  (arr[i] - arr[j]) is equal to k are:"<<cnt;
return 0;
	
}
