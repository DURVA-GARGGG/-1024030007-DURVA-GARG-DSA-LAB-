bool isLeaf(Tree* node) {
    return (node != NULL && node->left == NULL && node->right == NULL);
}

int sumOfLeftLeaves(Tree* root) {
    if (root == NULL) return 0;
    int sum = 0;

    if (isLeaf(root->left))
        sum += root->left->data;

    else
        sum += sumOfLeftLeaves(root->left);

    sum += sumOfLeftLeaves(root->right);
    return sum;
}
