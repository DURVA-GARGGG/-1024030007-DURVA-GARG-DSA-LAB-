#include<iostream>
#include<algorithm>
using namespace std;

int main()
{
    int arr[] = {1, 2, 2, 7, 3, 5, 4, 5, 6, 6, 7, 2, 9, 8};
    int n = sizeof(arr) / sizeof(arr[0]);

    sort(arr, arr + n); // sort the array

    int count = 1; // first element is always distinct

    for (int i = 1; i < n; i++) {
        if (arr[i] != arr[i - 1]) {
            count++;
        }
    }

    cout << "Total number of distinct elements are: " << count;
    return 0;
}
