#include <iostream>
#include <string>
#include <stack>
using namespace std;

bool check(string b) {
    stack<char> st;
    for (int i = 0; i < b.length(); i++) {
        char c = b[i];

        // If opening bracket, push
        if (c == '(' || c == '[' || c == '{') {
            st.push(c);
        }
        // If closing bracket
        else if (c == ')' || c == ']' || c == '}') {
            if (st.empty()) return false; // no opening to match

            char top = st.top();
            st.pop();

            // Matching check
            if ((c == ')' && top != '(') ||
                (c == ']' && top != '[') ||
                (c == '}' && top != '{')) {
                return false;
            }
        }
    }

    // At the end, stack should be empty
    return st.empty();
}

int main() {
    string s;
    cout << "Enter expression: ";
    getline(cin, s);

    if (check(s))
        cout << "Balanced\n";
    else
        cout << "Not Balanced\n";

    return 0;
}
